<!-- views/allCarts.handlebars -->
<div class="box">
  <h2>Todos los Carritos</h2>
  <div class="products-box">
    {{#each carts}}
      <div class="cart-card">
        <h3>Carrito ID: {{_id}}</h3>
        <hr>
        {{#if products.length}}
          {{#each products}}
            <div class="product-card">
              <h3>Producto ID: {{this.product._id}}</h3>
              <p>Título: {{this.product.title}}</p>
              <p>Precio: $ {{this.product.price}}</p>
              <p>Cantidad: {{this.quantity}}</p>
            </div>
            <br>
          {{/each}}
        {{else}}
          <p>Este carrito está vacío.</p>
        {{/if}}
      </div>
      <br>
    {{/each}}
    <div class="box">
      <a href="/products" class="button">
        Volver a Productos
      </a>
    </div>
  </div>
</div>

<div id="message" style="display:none;">Carrito actualizado!</div>

<script src="/js/allCarts.js"></script>
